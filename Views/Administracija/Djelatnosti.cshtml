@model IEnumerable<ZavrsniRad.Models.Djelatnosti>

@{
    ViewData["Title"] = "Administracija - Djelatnosti";
}

<div class="container-fluid py-4">

    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-1">Djelatnosti</h2>

            <p class="text-secondary mb-0">
                Administracija Å¡ifrarnika djelatnosti.
            </p>
        </div>
    </div>

    @if (TempData["GreskaBrisanja"] != null)
    {
        <div class="alert alert-warning" role="alert">
            @TempData["GreskaBrisanja"]
        </div>
    }

    @if (ViewBag.Greska != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Greska
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0 ">

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered">

                                <thead class="table-success">
                                    <tr>
                                        <th>Oznaka</th>
                                        <th>Naziv</th>
                                        <th>Status</th>

                                        <th class="text-center">
                                            Akcije
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="row-edit">

                                            <td class="fw-semibold">
                                                @item.Oznaka
                                            </td>

                                            <td>
                                                @item.Naziv
                                            </td>

                                            <td>
                                                @(item.Status ? "Aktivna" : "Neaktivna")
                                            </td>

                                            <td class="text-center text-nowrap">
                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#djelatnostModal"
                                                        data-id="@item.Id"
                                                        data-oznaka="@item.Oznaka"
                                                        data-naziv="@item.Naziv"
                                                        data-status="@item.Status.ToString().ToLowerInvariant()">
                                                    Uredi
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteDjelatnostModal"
                                                        data-id="@item.Id"
                                                        data-naziv="@item.Naziv">
                                                    ObriÅ¡i
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h5 class="mb-2">
                                Nema evidentiranih djelatnosti
                            </h5>

                            <p class="text-secondary mb-3">
                                TrenutaÄno nema unesenih podataka o djelatnostima.
                            </p>

                            <button type="button"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#djelatnostModal">
                                Dodaj prvu djelatnost
                            </button>
                        </div>
                    }

                </div>

                <div class="card-footer bg-white d-flex justify-content-end py-3">
                    <button type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#djelatnostModal">
                        Dodaj novu djelatnost
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@await Html.PartialAsync("_DjelatnostModal")
@await Html.PartialAsync("_DeleteDjelatnostModal")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('tr.row-edit').forEach(function (red) {
                red.addEventListener('dblclick', function () {
                    red.querySelector('button[data-bs-target="#djelatnostModal"]')?.click();
                });
            });
        });
    </script>

    @if (ViewBag.OtvoriModal == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(
                    document.getElementById('djelatnostModal')).show();
            });
        </script>
    }
}
