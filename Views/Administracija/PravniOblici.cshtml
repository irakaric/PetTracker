@model IEnumerable<ZavrsniRad.Models.PravniOblici>

@{
    ViewData["Title"] = "Administracija - Pravni oblici";
}

<div class="container-fluid py-4">

    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-1">Pravni oblici</h2>

            <p class="text-secondary mb-0">
                Administracija Å¡ifrarnika pravnih oblika.
            </p>
        </div>
    </div>

    @if (TempData["GreskaBrisanja"] != null)
    {
        <div class="alert alert-warning" role="alert">
            @TempData["GreskaBrisanja"]
        </div>
    }

    @if (ViewBag.Greska != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Greska
        </div>
    }

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0 ">

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered">

                                <thead class="table-success">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Status</th>

                                        <th class="text-center">
                                            Akcije
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="row-edit"
                                            data-id="@item.Id"
                                            data-naziv="@item.Naziv"
                                            data-status="@item.Status.ToString().ToLowerInvariant()">

                                            <td class="fw-semibold">
                                                @item.Naziv
                                            </td>

                                            <td>
                                                @(item.Status ? "Aktivan" : "Neaktivan")
                                            </td>

                                            <td class="text-center text-nowrap">
                                                <button type="button"
                                                        class="btn btn-warning btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#pravniOblikModal"
                                                        data-id="@item.Id"
                                                        data-naziv="@item.Naziv"
                                                        data-status="@item.Status.ToString().ToLowerInvariant()">
                                                    Uredi
                                                </button>

                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deletePravniOblikModal"
                                                        data-id="@item.Id"
                                                        data-naziv="@item.Naziv">
                                                    ObriÅ¡i
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h5 class="mb-2">
                                Nema evidentiranih pravnih oblika
                            </h5>

                            <p class="text-secondary mb-3">
                                TrenutaÄno nema unesenih podataka o pravnim oblicima.
                            </p>

                            <button type="button"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#pravniOblikModal">
                                Dodaj prvi pravni oblik
                            </button>
                        </div>
                    }

                </div>

                <div class="card-footer bg-white d-flex justify-content-end py-3">
                    <button type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#pravniOblikModal">
                        Dodaj novi pravni oblik
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@await Html.PartialAsync("_PravniOblikModal")
@await Html.PartialAsync("_DeletePravniOblikModal")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('tr.row-edit').forEach(function (red) {
                red.addEventListener('dblclick', function () {
                    // Ponovno se koristi gumb "Uredi" kako bi se modal popunio istim podacima
                    red.querySelector('button[data-bs-target="#pravniOblikModal"]')?.click();
                });
            });
        });
    </script>

    @if (ViewBag.OtvoriModal == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(
                    document.getElementById('pravniOblikModal')).show();
            });
        </script>
    }
}
