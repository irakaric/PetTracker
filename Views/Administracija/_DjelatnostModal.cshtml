
<div class="modal fade" id="djelatnostModal" tabindex="-1"
     aria-labelledby="djelatnostModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="SpremiDjelatnost" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" id="djelatnostId" value="0" />

                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title" id="djelatnostModalLabel">
                        Dodaj novu djelatnost
                    </h5>

                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Zatvori"></button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label class="form-label" for="djelatnostOznaka">
                            Oznaka
                        </label>

                        <input name="Oznaka" id="djelatnostOznaka"
                               class="form-control" maxlength="10" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="djelatnostNaziv">
                            Naziv djelatnosti
                        </label>

                        <input name="Naziv" id="djelatnostNaziv"
                               class="form-control" maxlength="50" required />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="Status" id="djelatnostStatus" value="true" checked />

                        <label class="form-check-label" for="djelatnostStatus">
                            Aktivna
                        </label>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-success">
                        Spremi
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Odustani
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('djelatnostModal');

        modal.addEventListener('show.bs.modal', function (dogadaj) {
            const gumb = dogadaj.relatedTarget;

            const naslov = document.getElementById('djelatnostModalLabel');
            const id = document.getElementById('djelatnostId');
            const oznaka = document.getElementById('djelatnostOznaka');
            const naziv = document.getElementById('djelatnostNaziv');
            const status = document.getElementById('djelatnostStatus');

            if (!gumb || !gumb.getAttribute('data-id')) {
                naslov.textContent = 'Dodaj novu djelatnost';

                id.value = '0';
                oznaka.value = '';
                naziv.value = '';
                status.checked = true;

                return;
            }

            naslov.textContent = 'UreÄ‘ivanje djelatnosti';

            id.value = gumb.getAttribute('data-id');
            oznaka.value = gumb.getAttribute('data-oznaka');
            naziv.value = gumb.getAttribute('data-naziv');
            status.checked = gumb.getAttribute('data-status') === 'true';
        });
    })();
</script>
