
<div class="modal fade" id="deletePrehranaModal" tabindex="-1"
     aria-labelledby="deletePrehranaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="ObrisiPrehranu" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" id="deletePrehranaId" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deletePrehranaModalLabel">
                        Brisanje prehrane
                    </h5>

                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Zatvori"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Jeste li sigurni da Å¾elite obrisati prehranu
                        <strong id="deletePrehranaNaziv"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        ObriÅ¡i
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Odustani
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('deletePrehranaModal');

        modal.addEventListener('show.bs.modal', function (dogadaj) {
            const gumb = dogadaj.relatedTarget;

            document.getElementById('deletePrehranaId').value =
                gumb.getAttribute('data-id');

            document.getElementById('deletePrehranaNaziv').textContent =
                gumb.getAttribute('data-naziv');
        });
    })();
</script>
