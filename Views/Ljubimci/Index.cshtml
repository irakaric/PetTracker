@model IEnumerable<ZavrsniRad.Models.Zivotinje>

@{
    ViewData["Title"] = "Ljubimci";
}

<div class="container-fluid py-4">

    <div class="row align-items-center mb-4">
        <div class="col">
            <h2 class="mb-1">Ljubimci</h2>

            <p class="text-secondary mb-0">
                Pregled i upravljanje podacima o ljubimcima.
            </p>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0 ">

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover table-bordered">

                                <thead class="table-success">
                                    <tr>
                                        <th>Naziv</th>
                                        <th>Vrsta Å¾ivotinje</th>
                                        <th>Pasmina</th>
                                        <th>Spol</th>
                                        <th>Boja</th>
                                        <th>Status</th>
                                        <th>Datum roÄ‘enja</th>

                                        <th class="text-center">
                                            Akcije
                                        </th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr class="row-edit"
                                            data-edit-url="@Url.Action("Edit", new { id = item.Id })">
                                            <td class="fw-semibold">
                                                @item.Naziv
                                            </td>

                                            <td>
                                                @item.ZivotinjeVrstePasmina?.ZivotinjeVrste?.Naziv
                                            </td>

                                            <td>
                                                @item.ZivotinjeVrstePasmina?.Pasmina?.Naziv
                                            </td>

                                            <td>
                                                @item.Spol?.Naziv
                                            </td>

                                            <td>
                                                @item.Boja
                                            </td>

                                            <td>
                                                @item.ZivotinjeStatusi?.Naziv
                                            </td>

                                            <td>
                                                @(item.DatumRodenja?.ToString("dd.MM.yyyy."))
                                            </td>

                                            <td class="text-center text-nowrap">
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-warning btn-sm">
                                                    Uredi
                                                </a>

                                                <button type="button"
                                                        class="btn btn-danger btn-sm"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#deleteLjubimacModal"
                                                        data-id="@item.Id"
                                                        data-naziv="@item.Naziv">
                                                    ObriÅ¡i
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <h5 class="mb-2">
                                Nema evidentiranih ljubimaca
                            </h5>

                            <p class="text-secondary mb-3">
                                TrenutaÄno nema unesenih podataka o ljubimcima.
                            </p>

                            <button type="button"
                                    class="btn btn-success"
                                    data-bs-toggle="modal"
                                    data-bs-target="#createLjubimacModal">
                                Dodaj prvog ljubimca
                            </button>
                        </div>
                    }

                </div>

                <div class="card-footer bg-white d-flex justify-content-end py-3">
                    <button type="button"
                            class="btn btn-success"
                            data-bs-toggle="modal"
                            data-bs-target="#createLjubimacModal">
                        Dodaj novog ljubimca
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@await Html.PartialAsync("_CreateModal",
    ViewBag.NoviLjubimac as ZavrsniRad.Models.Zivotinje
        ?? new ZavrsniRad.Models.Zivotinje { Naziv = "", Boja = "" })

@await Html.PartialAsync("_DeleteModal")

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @if (ViewBag.OtvoriCreateModal == true)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                new bootstrap.Modal(
                    document.getElementById('createLjubimacModal')).show();
            });
        </script>
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('tr.row-edit').forEach(function (red) {
                red.addEventListener('dblclick', function () {
                    window.location.href = red.dataset.editUrl;
                });
            });
        });
    </script>
}
