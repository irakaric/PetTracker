
<div class="modal fade" id="deleteSubjektModal" tabindex="-1"
     aria-labelledby="deleteSubjektModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-controller="Subjekti" asp-action="Obrisi" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" id="deleteSubjektId" />

                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="deleteSubjektModalLabel">
                        Deaktivacija subjekta
                    </h5>

                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Zatvori"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0">
                        Jeste li sigurni da Å¾elite deaktivirat subjekta
                        <strong id="deleteSubjektNaziv"></strong>?
                    </p>
                </div>

                <div class="modal-footer">
                    <button type="submit" class="btn btn-danger">
                        Deaktiviraj
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        Odustani
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script>
    (function () {
        const modal = document.getElementById('deleteSubjektModal');

        modal.addEventListener('show.bs.modal', function (dogadaj) {
            const gumb = dogadaj.relatedTarget;

            document.getElementById('deleteSubjektId').value =
                gumb.getAttribute('data-id');

            document.getElementById('deleteSubjektNaziv').textContent =
                gumb.getAttribute('data-naziv');
        });
    })();
</script>
